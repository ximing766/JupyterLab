<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <!-- Row 1: Name and Value -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvParamName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Parameter Name"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvParamValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#2196F3"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 2: Slider and Send Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderParam"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:stepSize="1.0"
                android:value="0.0"
                android:valueFrom="0.0"
                android:valueTo="100.0"
                app:thumbRadius="8dp"
                app:trackHeight="4dp" />

            <LinearLayout
                android:id="@+id/llStepper"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnMinus50"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:minWidth="40dp"
                    android:minHeight="36dp"
                    android:paddingHorizontal="4dp"
                    android:text="-50"
                    android:textColor="#E53935"
                    app:strokeColor="#E53935"
                    app:cornerRadius="12dp" />

                <Button
                    android:id="@+id/btnMinus"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:minWidth="40dp"
                    android:minHeight="36dp"
                    android:paddingHorizontal="4dp"
                    android:text="-10"
                    android:textColor="#E53935"
                    app:strokeColor="#E53935"
                    app:cornerRadius="12dp" />

                <Button
                    android:id="@+id/btnPlus"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:minWidth="40dp"
                    android:minHeight="36dp"
                    android:paddingHorizontal="4dp"
                    android:text="+10"
                    android:textColor="#43A047"
                    app:strokeColor="#43A047"
                    app:cornerRadius="12dp" />

                <Button
                    android:id="@+id/btnPlus50"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:minWidth="40dp"
                    android:minHeight="36dp"
                    android:paddingHorizontal="4dp"
                    android:text="+50"
                    android:textColor="#43A047"
                    app:strokeColor="#43A047"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnSetParam"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Send"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_send" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
